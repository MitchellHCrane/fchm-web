{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@ui/*": ["./packages/ui/*"],
      "@seo/*": ["./packages/seo/*"],
      "@config/*": ["./packages/config/*"],
      "@content/*": ["./packages/content/*"],
      "@assets/*": ["./packages/assets/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "scripts/**/*.mjs"
  ],
  "exclude": ["node_modules", "out", ".next"]
}
